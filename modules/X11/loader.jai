load_glx_functions :: () -> bool {
    all_loaded := true;
    glXChooseVisual = xx dlsym(glx_lib, "glXChooseVisual"); if glXChooseVisual == null  all_loaded = false;
    glXCreateContext = xx dlsym(glx_lib, "glXCreateContext"); if glXCreateContext == null  all_loaded = false;
    glXMakeCurrent = xx dlsym(glx_lib, "glXMakeCurrent"); if glXMakeCurrent == null  all_loaded = false;
    glXGetCurrentContext = xx dlsym(glx_lib, "glXGetCurrentContext"); if glXGetCurrentContext == null  all_loaded = false;
    glXSwapBuffers = xx dlsym(glx_lib, "glXSwapBuffers"); if glXSwapBuffers == null  all_loaded = false;
    glXDestroyContext = xx dlsym(glx_lib, "glXDestroyContext"); if glXDestroyContext == null  all_loaded = false;
    glXGetProcAddress = xx dlsym(glx_lib, "glXGetProcAddress"); if glXGetProcAddress == null  all_loaded = false;
    glXChooseFBConfig = xx dlsym(glx_lib, "glXChooseFBConfig"); if glXChooseFBConfig == null  all_loaded = false;
    glXGetFBConfigAttrib = xx dlsym(glx_lib, "glXGetFBConfigAttrib"); if glXGetFBConfigAttrib == null  all_loaded = false;
    glXGetVisualFromFBConfig = xx dlsym(glx_lib, "glXGetVisualFromFBConfig"); if glXGetVisualFromFBConfig == null  all_loaded = false;
    glXGetConfig = xx dlsym(glx_lib, "glXGetConfig"); if glXGetConfig == null  all_loaded = false;
    glXCreateWindow = xx dlsym(glx_lib, "glXCreateWindow"); if glXCreateWindow == null  all_loaded = false;
    return all_loaded;
}
