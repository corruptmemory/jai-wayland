// Runtime loader for the vendored X11/Xlib and GLX bindings.
// Keeps libX11/libGLX/libGL out of the executable link graph.

#import "POSIX";

x11_lib: *void;
glx_lib: *void;

init_x11 :: () -> bool {
    if XOpenDisplay != null  return true;

    x11_lib = dlopen("libX11.so.6", RTLD_LAZY);
    if !x11_lib  x11_lib = dlopen("libX11.so", RTLD_LAZY);
    if !x11_lib  return false;

    return load_x11_functions();
}

init_glx :: () -> bool {
    if glXGetProcAddress != null  return true;

    glx_lib = dlopen("libGLX.so.0", RTLD_LAZY);
    if !glx_lib  glx_lib = dlopen("libGLX.so", RTLD_LAZY);
    if !glx_lib  glx_lib = dlopen("libGL.so.1", RTLD_LAZY);
    if !glx_lib  glx_lib = dlopen("libGL.so", RTLD_LAZY);
    if !glx_lib  return false;

    return load_glx_functions();
}

load_x11_functions :: () -> bool {
    all_loaded := true;
    _Xmblen = xx dlsym(x11_lib, "_Xmblen"); if _Xmblen == null  all_loaded = false;
    XLoadQueryFont = xx dlsym(x11_lib, "XLoadQueryFont"); if XLoadQueryFont == null  all_loaded = false;
