// Runtime Vulkan loader. Keeps Vulkan out of the link graph; all commands are
// populated through the platform loader and vkGet*ProcAddr. Generated from
// PFN_vk* declarations in the vendored Vulkan headers.

#if OS == .WINDOWS {
W :: #import "Windows";
} else #if OS == .LINUX || OS == .ANDROID {
#import "POSIX";
}

init_vulkan :: () -> bool {
    #if OS == .WINDOWS {
        vulkan_lib := W.LoadLibraryA("vulkan-1.dll");
        if !vulkan_lib  return false;
        vkGetInstanceProcAddr = xx W.GetProcAddress(vulkan_lib, "vkGetInstanceProcAddr");
    } else #if OS == .LINUX || OS == .ANDROID {
        vulkan_lib := dlopen("libvulkan.so.1", RTLD_LAZY);
        if !vulkan_lib  vulkan_lib = dlopen("libvulkan.so", RTLD_LAZY);
        if !vulkan_lib  return false;
        vkGetInstanceProcAddr = xx dlsym(vulkan_lib, "vkGetInstanceProcAddr");
    }

    if vkGetInstanceProcAddr == null  return false;
    return load_vulkan_global_functions();
}

load_vulkan_global_functions :: () -> bool {
    vkCreateInstance = xx vkGetInstanceProcAddr(null, "vkCreateInstance");
    vkEnumerateInstanceExtensionProperties = xx vkGetInstanceProcAddr(null, "vkEnumerateInstanceExtensionProperties");
    vkEnumerateInstanceLayerProperties = xx vkGetInstanceProcAddr(null, "vkEnumerateInstanceLayerProperties");
    vkEnumerateInstanceVersion = xx vkGetInstanceProcAddr(null, "vkEnumerateInstanceVersion");
    vkGetDeviceProcAddr = xx vkGetInstanceProcAddr(null, "vkGetDeviceProcAddr");
    return vkCreateInstance != null && vkEnumerateInstanceExtensionProperties != null;
}

