load_vulkan_device_functions :: (device: VkDevice) -> bool {
    if vkGetDeviceProcAddr == null  return false;
    if vkAcquireNextImage2KHR == null  vkAcquireNextImage2KHR = xx vkGetDeviceProcAddr(device, "vkAcquireNextImage2KHR");
    if vkAcquireNextImageKHR == null  vkAcquireNextImageKHR = xx vkGetDeviceProcAddr(device, "vkAcquireNextImageKHR");
    if vkAllocateCommandBuffers == null  vkAllocateCommandBuffers = xx vkGetDeviceProcAddr(device, "vkAllocateCommandBuffers");
    if vkAllocateDescriptorSets == null  vkAllocateDescriptorSets = xx vkGetDeviceProcAddr(device, "vkAllocateDescriptorSets");
    if vkAllocateMemory == null  vkAllocateMemory = xx vkGetDeviceProcAddr(device, "vkAllocateMemory");
    if vkBeginCommandBuffer == null  vkBeginCommandBuffer = xx vkGetDeviceProcAddr(device, "vkBeginCommandBuffer");
    if vkBindBufferMemory == null  vkBindBufferMemory = xx vkGetDeviceProcAddr(device, "vkBindBufferMemory");
